{
  "latex-workshop.latex.recipe.default": "xelatex (fast)",
  "latex-workshop.latex.recipes": [
    {
      "name": "xelatex (fast)",
      "tools": ["xelatex"]
    },
    {
      "name": "xelatex → biber → xelatex ×2 (full)",
      "tools": ["xelatex", "biber", "xelatex", "xelatex"]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "xelatex",
      "command": "xelatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ]
    },
    {
      "name": "biber",
      "command": "biber",
      "args": ["%DOCFILE%"]
    }
  ],
  "latex-workshop.latex.autoBuild.run": "onSave"
}
